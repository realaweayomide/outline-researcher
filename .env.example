# Copy to ".env" and add a key to unlock the AI-generated outline.
# OPTIONAL — without it the tool still does all the research and analysis.

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# xAI / Grok alternative:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-2-latest
